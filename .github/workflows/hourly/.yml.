name: hourly-ingest

on:
  schedule:
    - cron: "15 * * * *"
  workflow_dispatch:

jobs:
  ingest:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      OPENAQ_API_KEY: ${{ secrets.OPENAQ_API_KEY }}
      DATABASE_URL: ${{ secrets.DATABASE_URL }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: pip install -r requirements.txt
      - name: Ingest latest pollution readings
        run: python ingest_latest.py
      - name: Ingest weather (last 3 days)
        env:
          PAST_DAYS: "3"
        run: python ingest_weather.py
